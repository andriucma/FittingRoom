# Copy to .env.local (repo root) and fill in. tryon-app/.env.local is a symlink to this file.
# Never commit real keys.

# Required: OpenAI (GPT Image 2.6 try-on, Decisions API gpt-6-luna for tagging)
OPENAI_KEY=sk-...

# Required for new try-on runs: Google Gemini (automatic Omni smooth video).
# Needs a billing-enabled project; Omni has no free tier.
GEMINI_API_KEY=

# Comma-separated Shopify store URLs. Restart the app after editing.
# Opening the outfit page automatically validates, imports, and tags missing stores.
SHOPIFY_STORE_URLS=https://gymsharkusa.myshopify.com,https://kith.com,https://www.aloyoga.com

# Optional: legacy single-store setting is still supported alongside the list.
# SHOPIFY_STOREFRONT_URL=https://gymsharkusa.myshopify.com

# Optional overrides
# TRYON_IMAGE_MODEL=gpt-image-2.6-flare
# TRYON_DECISIONS_MODEL=gpt-6-luna
# TRYON_OMNI_MODEL=gemini-omni-flash-preview
# TRYON_DATA_DIR=/absolute/path/to/data
# LOCAL_MODELS_PORT=8001
